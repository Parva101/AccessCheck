# AccessCheck - Environment Variables
# Copy this file to `.env` and fill in your values.
#
# Windows (PowerShell):
#   Copy-Item .env.example .env
#
# Linux/macOS:
#   cp .env.example .env

# Required: Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional alternative variable name (also supported by the app)
# GOOGLE_API_KEY=your-google-api-key-here

# Optional backend server port (used by server.py)
# PORT=8000